{
  "name": "alchemyx-erp-api",
  "version": "1.0.0",
  "private": true,
  "description": "AlchemyX ERP API (NestJS) on PostgreSQL (Neon)",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "migrate": "tsc -p tsconfig.build.json && node dist/db/migrate-cli.js",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
