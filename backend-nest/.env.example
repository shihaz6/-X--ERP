# Copy to .env (never commit .env) or set these in your host's environment.

# PostgreSQL / Neon. Use the pooled connection string, e.g.
# postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DB_POOL_SIZE=5

PORT=8080
APP_TIMEZONE=Asia/Colombo

# Comma-separated origins allowed to call the API (web app and the AlchemyX Connect phone app).
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost

# Session lifetime: 12h, 30m, 7d, ...
SESSION_TTL=12h

# Used in password-reset links.
FRONTEND_URL=http://localhost:8443

# Email. Leave MAIL_HOST empty to log emails instead of sending them.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=AlchemyX <no-reply@alchemyx.local>

# Daily jobs (six fields, seconds first).
BILLING_CRON=0 0 6 * * *
OVERDUE_CRON=0 0 7 * * *

# Apply migrations at start-up. Set to false to run them separately with `npm run migrate`.
RUN_MIGRATIONS=true

# Used only when the members table is empty, to create the first Super Admin.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
